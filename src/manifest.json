{
  "manifest_version": 3,
  "name": "don't check social media",
  "version": "2.2",
  "description": "Blocks TikTok, X and Instagram and displays a demotivating message",

  "permissions": ["storage"],

  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.instagram.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["youtube-filter.css"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
