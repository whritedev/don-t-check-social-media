{
  "manifest_version": 3,
  "name": "don't check social media",
  "description": "Blocks TikTok, X and Instagram and displays a demotivating message",
  "version": "2.2",

  "permissions": ["declarativeNetRequest", "storage"],

  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.instagram.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["youtube-filter.css"]
    }
  ]
}
